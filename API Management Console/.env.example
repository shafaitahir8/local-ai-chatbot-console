# ============================================
# Local AI Chatbot Deployment Console
# Environment Configuration
# ============================================

# --------------------------------------------
# Admin Authentication
# --------------------------------------------
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=your-secret-key-change-this-in-production

# --------------------------------------------
# Encryption
# --------------------------------------------
# Used to encrypt API keys stored in database
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_SECRET=your-encryption-secret-change-this

# --------------------------------------------
# Control Plane Storage
# --------------------------------------------
# Production: use PostgreSQL. Development may omit this to fall back to local SQLite.
# Example:
# DATABASE_URL=postgresql+psycopg://chatbot:chatbot@127.0.0.1:5432/chatbot_console
DATABASE_URL=

# Optional shared backend for multi-process rate limiting.
# Example:
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# --------------------------------------------
# OpenAI Configuration
# --------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key

# --------------------------------------------
# Anthropic Claude Configuration (Future)
# --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --------------------------------------------
# Local LLM Configuration
# --------------------------------------------
LOCAL_LLM_URL=http://localhost:8080

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Comma-separated list of allowed origins
# Use * for development, specific origins for production
CORS_ORIGINS=*

# --------------------------------------------
# Public Tunnel Configuration
# --------------------------------------------
# Choose: cloudflare, localtunnel, ngrok
TUNNEL_PROVIDER=cloudflare

# Optional hardening: expose only /api/bot/* and /embed/* through the tunnel gateway
TUNNEL_API_ONLY=true

# Shared secret added as Authorization: Bearer <token> or X-Tunnel-Token for public calls.
# Query-string ?token=... remains a temporary compatibility fallback when PUBLIC_QUERY_TOKEN_COMPAT=true.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
TUNNEL_SHARED_SECRET=
PUBLIC_QUERY_TOKEN_COMPAT=true
PUBLIC_JSON_BODY_LIMIT_BYTES=65536

# ---- Cloudflare Named Tunnel (recommended for static URL) ----
# Use a named tunnel token and fixed public base URL for a stable endpoint
# Example:
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
# CLOUDFLARE_PUBLIC_BASE_URL=https://chat.example.com
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_BASE_URL=

# ---- LocalTunnel (may still be unstable if subdomain is unavailable) ----
LOCALTUNNEL_SUBDOMAIN=

# ---- ngrok static domain mode ----
# Requires ngrok account + reserved domain.
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=
NGROK_PATH=
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels

# --------------------------------------------
# Server Configuration
# --------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
