[Unit]
Description=Chatbot Console API
After=network.target postgresql.service redis.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/chatbot-console
EnvironmentFile=/opt/chatbot-console/.env
Environment=APP_ENV=production
Environment=APP_RUNTIME_ROLE=api
ExecStart=/opt/chatbot-console/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
