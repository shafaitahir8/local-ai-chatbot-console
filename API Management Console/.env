# Local AI Chatbot Deployment Console - Environment Configuration
# Copy to .env and update with your values

ADMIN_USERNAME=admin
ADMIN_PASSWORD=shaf123
JWT_SECRET=local-dev-jwt-secret-change-in-production
ENCRYPTION_SECRET=local-dev-encryption-secret-change-in-production

# OpenAI API Key (required for OpenAI bots)
OPENAI_API_KEY=

# Anthropic API Key (optional, for Claude bots)
ANTHROPIC_API_KEY=

# Local LLM server URL (default for Ollama)
LOCAL_LLM_URL=http://localhost:11434

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CORS - use * for development
CORS_ORIGINS=*
